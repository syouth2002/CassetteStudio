<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><ProjectGuid>{4981C584-7079-4A9F-80EA-A651E8C2B193}</ProjectGuid><Keyword>MakeFileProj</Keyword><RootNamespace>CassetteStudio</RootNamespace><WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration"><ConfigurationType>Makefile</ConfigurationType><PlatformToolset>v145</PlatformToolset></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <RustCargo>$(USERPROFILE)\.cargo\bin\cargo.exe</RustCargo>
    <RustProfile Condition="'$(Configuration)'=='Debug'">debug</RustProfile>
    <RustProfile Condition="'$(Configuration)'=='Release'">release</RustProfile>
    <RustFlags Condition="'$(Configuration)'=='Release'">--release</RustFlags>
    <NMakeBuildCommandLine>cd /d "$(ProjectDir)" &amp;&amp; "$(RustCargo)" build $(RustFlags) --features desktop --bins --locked</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>cd /d "$(ProjectDir)" &amp;&amp; "$(RustCargo)" clean &amp;&amp; "$(RustCargo)" build $(RustFlags) --features desktop --bins --locked</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>cd /d "$(ProjectDir)" &amp;&amp; "$(RustCargo)" clean</NMakeCleanCommandLine>
    <NMakeOutput>$(ProjectDir)target\$(RustProfile)\cassette-studio-desktop.exe</NMakeOutput>
    <LocalDebuggerCommand>$(NMakeOutput)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <OutDir>$(ProjectDir)target\$(RustProfile)\</OutDir>
    <IntDir>$(ProjectDir)target\vs\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Cargo.toml" /><None Include="Cargo.lock" /><None Include="README.md" /><None Include="README.ja.md" /><None Include="docs\architecture*.md" />
    <None Include="src\**\*.rs" /><None Include="web\**\*" /><None Include="scripts\*" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
